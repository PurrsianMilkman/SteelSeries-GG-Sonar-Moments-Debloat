@echo off
rem  GG-Debloat for SteelSeries GG 123.0.0 -- Sonar + Moments only: no telemetry, no account, no ads.
rem  Put SteelSeriesGG123.0.0Setup.exe next to this file and double-click it. Everything below the
rem  marker line at the bottom of the header is plain, readable PowerShell + C# (generated by build.py).
rem  Options (run from a command prompt):  GG-Debloat-123.bat -Undo | -SelfTest | -Allow-Moments-Network
setlocal
set "GGD_SELF=%~f0"
set "GGD_HERE=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:GGD_SELF); $m='#<PAY'+'LOAD>'; $i=$t.IndexOf($m); $s=$t.Substring($i+$m.Length); $f=Join-Path $env:TEMP ('gg-debloat-'+[guid]::NewGuid().ToString('N')+'.ps1'); [IO.File]::WriteAllText($f,$s,(New-Object Text.UTF8Encoding($true))); & powershell -NoProfile -ExecutionPolicy Bypass -File $f -Here $env:GGD_HERE.TrimEnd('\') %*; $c=$LASTEXITCODE; Remove-Item $f -Force -ErrorAction SilentlyContinue; exit $c"
exit /b %ERRORLEVEL%
#<PAYLOAD>
