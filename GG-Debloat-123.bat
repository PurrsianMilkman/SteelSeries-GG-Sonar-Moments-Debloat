      new P(@"route-news-off", @"path:""news/\*""", 1, @"News page (ads/promos)"),
      new P(@"route-giveaways-off", @"path:""giveaways/\*""", 1, @"Giveaways page (ads)"),
      new P(@"route-quickset-off", @"path:""quickset/\*""", 1, @"Loadouts page (needs Engine)"),
      new P(@"state-default-app-sonar", @"(activeApplication:\w+\.\w+\.)NEWS(,skipLoginModalOpen)", -1, @"initial activeApplication (module is duplicated across chunks)"),
      new P(@"state-default-home-sonar", @"(homeApp:\w+\.\w+\.)NEWS(\})", -1, @"initial homeApp (module is duplicated across chunks)"),
      new P(@"nav-sonar-moments-only", @"(?<ce>\w+\.createElement)\((?<ul>\w+),null,(?<s>\w+)\),\k<ce>\((?<ft>\w+),null,\k<ce>\(\w+,null\),\k<ce>\(\w+,null\),\k<ce>\(\w+,null\),\k<ce>\((?<set>\w+),null\)\)", 1, @"nav items except SONAR/MOMENTS; footer Account(sign-in nag)/Discord/Feedback buttons"),
      new P(@"sonar-no-contentful-toast", @"\w+&&!\w+&&\w+&&(?=\w+\.createElement\(\w+,\{contentfulData:\w+,onClickDismiss:\w+,inAppToastDismissed:\w+,className:""InAppToast""\}\))", 1, @"Sonar in-app promo toast (Contentful)"),
